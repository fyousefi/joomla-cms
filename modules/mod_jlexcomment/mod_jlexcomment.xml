<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" version="3.0" method="upgrade">
	<name>JLex Comment</name>
	<author>JLexArt</author>
	<creationDate>Jun 16, 2024</creationDate>
	<copyright>Copyright (C) 2013-2021 JLexArt Team</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorUrl>www.jlexart.com</authorUrl>
	<version>2.1.6</version>
	<description><![CDATA[
	<div style="clear:both">
	The JLex Comment Modules. Get another its addons at <a href="https://www.jlexart.com/addons/jlex-comment" target="_blank">HERE.</a>
	</div>
	]]></description>
	<files>
		<filename module="mod_jlexcomment">mod_jlexcomment.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<folder>assets</folder>
		<folder>elements</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">en-GB.mod_jlexcomment.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldpath="/modules/mod_jlexcomment/elements">
				<field type="list" class="btn-group" name="type" label="Select type" default="latest_comment">
					<option value="latest_comment">Latest Comments</option>
					<option value="most_comment">The Most Commented Items</option>
					<option value="top_poster">Top Users</option>
					<option value="comment_form">Discussion Page</option>
				</field>



				<field type="label" default="Latest Comment" showon="type:latest_comment"/>
				<field 	type="text"
						name="lc_limit_words"
						label="Limit Words"
						description="Fill 0 for full comment"
						default="0" showon="type:latest_comment" />
				<field 	type="radio"
						name="lc_media"
						label="Media (File attachment)"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="1">Extend</option>
					<option value="0">JNO</option>
				</field>
				<field 	type="radio"
						name="lc_avatar"
						label="Avatar"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="radio"
						name="lc_date"
						label="Date"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="1">Extend</option>
					<option value="0">JHIDE</option>
				</field>
				<field 	type="radio"
						name="lc_entry"
						label="Object Title"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="1">JSHOW</option>
					<option value="0">JHIDE</option>
				</field>
				<field 	type="radio"
						name="lc_reply_comment"
						label="Child Comment"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="radio"
						name="lc_reply_parent"
						label="The Author of Parent Comment"
						default="1"
						class="btn-group" showon="type:latest_comment">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>


				<field type="label" default="The Most Commented Items" showon="type:most_comment"/>
				<field 	type="radio"
						name="mc_count_cm"
						label="Number Comment"
						default="1"
						class="btn-group" showon="type:most_comment"
						>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="radio"
						name="mc_count_cm_reply"
						label="Include Number Reply"
						default="1"
						class="btn-group" showon="type:most_comment[AND]mc_count_cm:1"
						>
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>

				<field type="label" default="Top Users" showon="type:top_poster"/>
				<field 	type="radio"
						name="tp_count_cm"
						label="Number Comment"
						default="1"
						class="btn-group" showon="type:top_poster">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="radio"
						name="tp_count_cm_reply"
						label="Include Number Reply"
						default="1"
						class="btn-group" showon="type:top_poster[AND]tp_count_cm:1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="radio"
						name="tp_thumbnail"
						label="Avatar Thumbnail"
						default="1"
						class="btn-group" showon="type:top_poster">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field 	type="text"
						name="tp_period"
						label="Period (day)"
						default="0"
						description="Fill 0 to disable this filter"
						filter="int" showon="type:top_poster" />


				<field type="label" default="Discussion Page" showon="type:comment_form" />
				<field type="list" name="item_source" label="Item Source" showon="type:comment_form" default="1">
					<option value="1">New Item</option>
					<option value="2">Available Item</option>
					<option value="3">Dynamic Item</option>
				</field>

				<field 	type="text"
						name="cf_entry_type"
						label="Item Component"
						hint="Example: k2" showon="type:comment_form[AND]item_source!:1" />
				<field 	type="text"
						name="cf_entry_id"
						label="Item ID" showon="type:comment_form[AND]item_source:2" />
				<field 	type="text"
						name="cf_entry_title"
						label="Item Title" showon="type:comment_form[AND]item_source:1" />
				<field 	type="text"
						name="cf_var_id"
						label="Dynamic Variable Name" showon="type:comment_form[AND]item_source:3" default="id" />


				<field type="label" default="Restrictions" showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster"/>
				<field type="com" name="area" label="Filter by Component" default="0" showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster" />
				<field type="text" name="area_extra" label="Extra Component" description="Use it if your component not found in the listing. Separated by commas." showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster" />
				<field type="text" name="entry_ids" label="Comment Items ID" description="Search only in these comment items. Fill 0 (zero) for all." default="0" showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster" />
				<field name="pagination" type="radio" class="btn-group" label="Pagination" default="0" showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster">
					<option value="1">JYES</option>
					<option value="0">JNO</option>
				</field>
				<field type="text" name="limit" label="Number Items Per Page" filter="int" default="10" showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster" />
				<field name="page_prefix" type="text" label="Pagination Prefix" description="The prefix used for request variables." showon="type:latest_comment[OR]type:most_comment[OR]type:top_poster" />
			</fieldset>
			<fieldset name="advanced">
				<field name="moduleclass_sfx" type="text" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />

				<field
					name="cache"
					type="list"
					default="1"
					label="COM_MODULES_FIELD_CACHING_LABEL"
					description="COM_MODULES_FIELD_CACHING_DESC">
					<option
						value="1">JGLOBAL_USE_GLOBAL</option>
					<option
						value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
	
