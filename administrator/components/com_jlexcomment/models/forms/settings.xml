<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="jform">
        <fieldset name="notification">
            <field name="notification" 
                    label="JCM_NOTIFICATION" 
                    type="radio" 
                    class="btn-group"
                    default="0"
                    >
                <option value="0">JCM_DISABLE</option>
                <option value="1">JCM_ENABLE</option>
            </field>
            <field  name="alert_reply" 
                    label="JCM_INCLUDE_REPLY" 
                    type="radio" 
                    class="btn-group"
                    default="0"
                    
                    showon="notification:1"
                    >
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field  name="alert_method" 
                    label="JCM_SENDING_METHOD" 
                    type="list"
                    default="0"
                    showon="notification:1"
            >
                <option value="1">JCM_IMMEDIATELY</option>
                <option value="0">JCM_CRONJOB_RED</option>
            </field>
            <field  name="alert_date" 
                    label="JCM_BEGIN_DATE" 
                    type="calendar"
                    format="%Y-%m-%d %H:%M:%S"
                    filterformat="Y-m-d H:i:s"
                    default="now" showon="notification:1" />
            <field  name="alert_email" 
                    label="JCM_EMAIL" 
                    type="text"
                    description="JCM_EMAIL_NOF_DESC" showon="notification:1" />
            <field  name="alert_quick_task" 
                    label="JCM_QUICK_MOD" 
                    type="radio" 
                    class="btn-group"
                    default="1"
                    
                    description="JCM_QUICK_MOD_DESC">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
            <field  name="email_to_owner" 
                    label="JCM_SEND_COPY_OWN" 
                    type="radio" 
                    class="btn-group"
                    default="0"
                    
                    description="JCM_SEND_COPY_OWN_DESC">
                <option value="0">JNO</option>
                <option value="1">JYES</option>
            </field>
        </fieldset>

        <fieldset name="notification_user">
            <field  name="nof_user" 
                    label="JCM_NOTIFICATION" 
