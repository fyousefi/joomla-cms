            <field type="text" name="oauth_tw_public" label="JCM_TW_API_KEY" showon="oauth_tw:1" />
            <field type="text" name="oauth_tw_secret" label="JCM_TW_API_SECRET" showon="oauth_tw:1" />
            <field type="jcm_ogurl" label="JCM_TW_REDIRECT" method="twitter" showon="oauth_tw:1" />

            <field  name="oauth_gg" 
                    label="JCM_LOGIN_USE_GOOGLE_ACCOUNT" 
                    type="radio" 
                    class="btn-group"
                    default="0"
                    >
                <option value="0">JCM_DISABLE</option>
                <option value="1">JCM_ENABLE</option>
            </field>

            <field type="text" name="oauth_gg_public" label="JCM_GG_CLIENT_ID" showon="oauth_gg:1"/>
            <field type="text" name="oauth_gg_secret" label="JCM_GG_CLIENT_SECRET" showon="oauth_gg:1" />
            <field type="jcm_ogurl" label="JCM_GG_REDIRECT" method="google" showon="oauth_gg:1" />

            <field  name="oauth_vk" 
                    label="JCM_LOGIN_USE_VK_ACCOUNT" 
                    type="radio" 
                    class="btn-group"
                    default="0"
                    >
                <option value="0">JCM_DISABLE</option>
                <option value="1">JCM_ENABLE</option>
            </field>

            <field type="text" name="oauth_vk_app_id" label="JCM_VK_APP_ID" showon="oauth_vk:1" />
            <field type="text" name="oauth_vk_app_secret" label="JCM_VK_APP_SECRET" showon="oauth_vk:1" />

            <field  name="oauth_sign_up" 
